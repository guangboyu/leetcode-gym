# Normalize to LF in the repo so the Linux machine gets clean line endings.
* text=auto eol=lf

# PowerShell scripts are Windows-only; keep CRLF in working copies on Windows.
*.ps1 text eol=crlf

# Treat JSON/markdown as text (they contain UTF-8 incl. Chinese).
*.json text
*.md text

# Tutorial assets and bundled fonts are binary; never line-ending convert them.
*.gif binary
*.png binary
*.ttf binary
