     "label": "Shape 1: converging",
     "name": "converging",
     "anchor": "shape-1-converging",
     "parent": null,
     "blurb": "Two pointers start at the ends and walk toward each other. Each iteration either records an answer or discards one endpoint forever.",
     "template": "l, r = 0, len(a) - 1\nwhile l < r:\n    if too_small(a[l], a[r]):\n        l += 1              # a[l] is worthless, name why\n    elif too_big(a[l], a[r]):\n        r -= 1\n    else:\n        record(l, r)\n        l += 1\n        r -= 1",
